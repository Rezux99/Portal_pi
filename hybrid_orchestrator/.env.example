# Never commit .env. Keep secrets outside prompts, logs and source control.
ORCHESTRATOR_API_SECRET=change-this-long-random-secret
MIN_QUALITY=0.82
PROVIDERS=modal,free1,free2

# Modal OpenAI-compatible endpoint requested by Jaime
MODAL_BASE_URL=https://api.us-west-2.modal.direct/v1
MODAL_API_KEY=replace-with-modal-key
MODAL_MODEL=replace-with-model
MODAL_ENABLED=true
MODAL_CONCURRENCY=2
MODAL_TIMEOUT_S=45

# Any other OpenAI-compatible free provider
FREE1_BASE_URL=https://provider.example/v1
FREE1_API_KEY=replace-with-key
FREE1_MODEL=replace-with-model
FREE1_ENABLED=false
FREE1_CONCURRENCY=1
FREE1_TIMEOUT_S=45

FREE2_BASE_URL=
FREE2_API_KEY=
FREE2_MODEL=
FREE2_ENABLED=false
FREE2_CONCURRENCY=1
FREE2_TIMEOUT_S=45
